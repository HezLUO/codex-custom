+#[tokio::test]
+async fn context_details_matches_status_after_usage_updates() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.config.model_context_window = Some(1_000_000);
+    chat.local_settings.tui.status_line = Some(vec!["context-details".to_string()]);
+
+    // A decreasing active context models a post-compaction update. Cumulative
+    // usage stays much larger than the active window throughout the sequence.
+    for (tokens, window, expected) in [
+        (33_800, 475_000, "Context 95% left (33.8K used / 475K)"),
+        (12_700, 13_000, "Context 30% left (12.7K used / 13K)"),
+        (0, 475_000, "Context 100% left (0 used / 475K)"),
+        (600_000, 475_000, "Context 0% left (600K used / 475K)"),
+    ] {
+        let mut info = make_token_info(tokens, window);
+        info.total_token_usage.total_tokens = 9_000_000;
+        info.total_token_usage.input_tokens = 8_000_000;
+        handle_token_count(&mut chat, Some(info));
+        chat.refresh_status_line();
+        assert_eq!(status_line_text(&chat).as_deref(), Some(expected));
+        assert_eq!(
+            chat.status_surface_preview_data()
+                .value_for(crate::bottom_pane::StatusLineItem::ContextDetails.preview_item()),
+            Some(expected)
+        );
+
+        chat.add_status_output(false, None);
+        let cells = drain_insert_history_with(&mut rx, |cell| cell.display_lines(200));
+        let context_line = cells
+            .last()
+            .expect("status output inserted")
+            .iter()
+            .map(ToString::to_string)
+            .find(|line| line.contains("Context window"))
+            .expect("context window line");
+        let status_value = context_line
+            .split_once("Context window:")
+            .expect("context window label")
+            .1
+            .trim();
+        assert_eq!(expected, format!("Context {status_value}"));
+    }
+}
+
+#[tokio::test]
+async fn context_details_handles_pending_and_unknown_usage_like_status() {
+    let (mut chat, _rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    let item = crate::bottom_pane::StatusLineItem::ContextDetails;
+    chat.config.model_context_window = Some(475_000);
+    chat.token_info = None;
+    chat.token_usage_pending = false;
+    assert_eq!(
+        chat.status_line_value_for_item(item).as_deref(),
+        Some("Context 100% left (0 used / 475K)")
+    );
+
+    chat.token_usage_pending = true;
+    assert_eq!(chat.status_line_value_for_item(item), None);
+    chat.token_usage_pending = false;
+    chat.config.model_context_window = None;
+    assert_eq!(chat.status_line_value_for_item(item), None);
+
+    // A known config capacity must not replace an explicitly unknown runtime
+    // window: /status also omits the context row in this case.
+    chat.config.model_context_window = Some(475_000);
+    let mut info = make_token_info(33_800, 475_000);
+    info.model_context_window = None;
+    chat.token_info = Some(info);
+    assert_eq!(chat.status_line_value_for_item(item), None);
+}
